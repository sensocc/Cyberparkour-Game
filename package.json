{
  "name": "cyberparkour",
  "private": true,
  "version": "0.3.0",
  "description": "Cyberparkour - a low-poly, Quake-styled first-person parkour game set in a cyberpunk city. V0.3: wall running, wall jumping, vaulting, Kong vaults, landing rolls, checkpoints and a district of rooftops.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "assets": "node tools/generate-textures.ts",
    "build": "npm run typecheck && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run typecheck && npm run test:coverage && npm run build:only"
  },
  "dependencies": {
    "playwright-core": "^1.63.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "main": "index.js",
  "keywords": [],
  "author": ""
}
